# Copy to .env.local

# PostgreSQL connection string
DATABASE_URL="postgresql://pizzalogs:pizzalogs@localhost:5432/pizzalogs?schema=public"

# Python parser service URL
PARSER_SERVICE_URL="http://localhost:8000"

# Server-only authentication encryption/signing key (at least 32 random characters).
# This is never entered into the browser as a login credential.
ADMIN_SECRET=""
ADMIN_AUTH_URL="http://localhost:3000"

# Optional for local HTTP-only production-mode compose.
# Do not set false in Railway.
# ADMIN_COOKIE_SECURE="false"

# Parser compatibility escape hatch. Leave disabled in production.
# ENABLE_LEGACY_PARSER_ROUTES="false"
# ENABLE_PARSER_DOCS="false"

# Optional owner-notification worker. Keep these server-only and configure them
# on the separate Railway cron service, not the public Web or Parser services.
RESEND_API_KEY=""
REPORT_EMAIL_FROM="Pizza Logs <notifications@example.com>"
REPORT_EMAIL_TO=""
SITE_URL="http://localhost:3000"
RAILWAY_API_TOKEN=""
RAILWAY_PROJECT_ID=""
RAILWAY_WORKSPACE_ID=""
RAILWAY_ENVIRONMENT_ID=""
RAILWAY_WEB_SERVICE_ID=""
RAILWAY_PLAN_NAME="Hobby"
RAILWAY_PLAN_INCLUDED_USD="5"
DIGEST_SEND_HOUR_UTC="12"
