{
  "name": "pizza-logs",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "node scripts/run-tests.mjs",
    "docs:check": "node scripts/check-doc-links.mjs",
    "locks:check": "node scripts/check-python-locks.mjs",
    "smoke:production": "node scripts/production-smoke.mjs",
    "check:pr": "npm run lint && npm run type-check && npm run type-check:ecosystem && npm test && npm run docs:check && npm run locks:check && npm run build",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "type-check": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "type-check:ecosystem": "tsc --noEmit",
    "db:seed-items": "tsx scripts/seed-wow-items.ts",
    "db:import-items": "tsx scripts/import-item-template.ts",
    "gear-sync:uninstall-task": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/gear-sync/uninstall-windows-task.ps1",
    "guild-roster-sync:uninstall-task": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/guild-roster-sync/uninstall-windows-task.ps1"
  },
  "dependencies": {
    "@fontsource/cinzel": "5.3.0",
    "@fontsource/rajdhani": "5.3.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-dropzone": "^20.1.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.21.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4"
  }
}
